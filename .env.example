NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beauty_clinic_api
DB_USER=clinic_app
DB_PASSWORD=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
OTP_HASH_SECRET=replace-with-another-long-random-secret
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_PHONE_LIMIT=10
OTP_DAILY_IP_LIMIT=50
REFRESH_TOKEN_DAYS=30
SMS_DRIVER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=ClinicOtp
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=5242880
BOOKING_AUTO_CONFIRM=false
TEHRAN_TIMEZONE=Asia/Tehran
ADMIN_SEED_PHONE=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
LOG_LEVEL=info
